[Unit]
Description=llama.cpp server — Qwen 2.5 7B mid-tier LLM (Pattern 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ comfy_user }}
Group={{ comfy_group }}
WorkingDirectory={{ llm_backend_dir }}
ExecStart={{ llm_backend_dir }}/llama.cpp/build/bin/llama-server \
    --model {{ llm_backend_dir }}/models/qwen2.5-7b-instruct-q4_k_m.gguf \
    --host 127.0.0.1 --port {{ llm_backend_port }} \
    --n-gpu-layers 999 \
    --ctx-size 8192 \
    --threads 8 \
    --api-key local \
    --alias qwen2.5-7b
Restart=on-failure
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
